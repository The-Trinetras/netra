{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netra.local/contracts/protocol/v1/client_to_server.schema.json",
  "title": "Netra Client To Server Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_id",
    "session_id",
    "request_id",
    "sequence",
    "type",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": [
        "session.resume",
        "turn.submit",
        "navigation.command",
        "response.cancel",
        "playback.ack",
        "asr.start"
      ]
    },
    "payload": {
      "type": "object"
    }
  },

  "allOf": [
    {
      "if": {
        "properties": {
          "type": { "const": "session.resume" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/SessionResume" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "turn.submit" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/TurnSubmit" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "navigation.command" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/NavigationCommand" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "response.cancel" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/ResponseCancel" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "playback.ack" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/PlaybackAck" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": { "const": "asr.start" }
        }
      },
      "then": {
        "properties": {
          "payload": { "$ref": "#/$defs/AsrStart" }
        }
      }
    }
  ],

  "$defs": {
    "SessionResume": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_known_session_version"
      ],
      "properties": {
        "last_known_session_version": {
          "type": "integer",
          "minimum": 0
        },
        "last_acknowledged_sentence_id": {
          "type": ["string", "null"]
        }
      }
    },

    "TurnSubmit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utterance",
        "input_mode",
        "transcript_status",
        "expected_session_version"
      ],
      "properties": {
        "utterance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "input_mode": {
          "enum": ["keyboard", "voice"]
        },
        "transcript_status": {
          "const": "final"
        },
        "expected_session_version": {
          "type": "integer",
          "minimum": 0
        },
        "client_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },

    "NavigationCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "expected_session_version"
      ],
      "properties": {
        "command": {
          "enum": [
            "stop",
            "pause",
            "continue",
            "next",
            "previous",
            "repeat",
            "where_am_i",
            "back_to_reading",
            "undo_jump",
            "return_to_question"
          ]
        },
        "navigation_unit": {
          "enum": [
            "sentence",
            "block",
            "heading",
            "figure",
            "equation"
          ]
        },
        "expected_session_version": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "ResponseCancel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancel_request_id"
      ],
      "properties": {
        "cancel_request_id": {
          "type": "string",
          "format": "uuid"
        },
        "generation_id": {
          "type": ["string", "null"]
        },
        "reason": {
          "enum": [
            "user_stop",
            "new_turn",
            "navigation",
            "client_shutdown"
          ]
        }
      }
    },

    "PlaybackAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_id",
        "segment_id",
        "sentence_id",
        "status"
      ],
      "properties": {
        "generation_id": {
          "type": "string"
        },
        "segment_id": {
          "type": "string"
        },
        "sentence_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "started",
            "progress",
            "completed"
          ]
        },
        "played_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },

    "AsrStart": {
      "$comment": "Decision D-MIC (20 September 2026): starts one push-to-talk capture. The client then sends the capture's audio as binary frames described by microphone_frame_header.schema.json, ending with end_of_utterance. The envelope request_id identifies the capture: every asr.transcript and error about it carries the same request_id. At most one capture is open per connection; a new asr.start ends the open one without a final transcript, and a disconnect abandons it. A capture_id is never reused. The server only transcribes: the client submits the final text as an ordinary turn.submit with input_mode voice, reusing one request_id per transcript_id so a redelivered final cannot create a second turn. Interim text never becomes a turn.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_id"
      ],
      "properties": {
        "capture_id": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
