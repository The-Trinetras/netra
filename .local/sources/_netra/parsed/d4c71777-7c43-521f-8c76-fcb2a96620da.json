{"blocks":[{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,56.731,512.84,79.401],"page_index":0,"parent_id":"document","parent_path":[]},"text":"An Operating System (OS) is the foundational software that manages computer\nhardware and software resources."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,90.781,506.84,113.451],"page_index":0,"parent_id":"document","parent_path":[]},"text":"It acts as an intermediary between the user of a computer and the physical\nsilicon hardware."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,124.831,512.84,147.501],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Without an OS, every application would need custom code to handle low-level\noperations like reading from a disk or drawing to a screen."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,158.881,518.84,181.551],"page_index":0,"parent_id":"document","parent_path":[]},"text":"The core of any operating system is the kernel, which remains in main memory\ncontinuously."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,192.931,500.84,215.601],"page_index":0,"parent_id":"document","parent_path":[]},"text":"The kernel operates in a privileged state known as kernel mode, giving it\nunrestricted access to hardware."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,226.981,542.85,249.651],"page_index":0,"parent_id":"document","parent_path":[]},"text":"User applications run in a restricted user mode to prevent them from crashing or\naltering critical system structures."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,261.031,536.84,283.701],"page_index":0,"parent_id":"document","parent_path":[]},"text":"System calls provide the programmatic interface for user applications to safely\nrequest services from the kernel."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,295.081,542.85,317.751],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Modern OS architectures can be broadly categorized into monolithic, microkernel,\nhybrid, or exokernel designs."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,329.131,536.84,351.801],"page_index":0,"parent_id":"document","parent_path":[]},"text":"A monolithic kernel houses all core OS services in a single large block of code\nand memory space for speed."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,363.181,536.84,385.851],"page_index":0,"parent_id":"document","parent_path":[]},"text":"A microkernel strips the kernel down to basic inter-process communication (IPC)\nand scheduling, running other services in user space to improve stability."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,397.231,542.85,419.901],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Process management is one of the OS's most critical responsibilities for keeping\nthe system responsive."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,431.281,500.84,453.951],"page_index":0,"parent_id":"document","parent_path":[]},"text":"A process is a program in active execution, complete with its own program\ncounter, registers, and memory space."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,465.331,530.84,488.001],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Process Control Blocks (PCBs) are complex data structures the OS uses to store\nall information about specific processes."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,499.381,542.85,522.051],"page_index":0,"parent_id":"document","parent_path":[]},"text":"CPU scheduling determines which process gets control of the processor when there\nare multiple runnable processes."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,533.431,506.84,556.101],"page_index":0,"parent_id":"document","parent_path":[]},"text":"The dispatcher is the module that actually gives control of the CPU to the\nprocess selected by the short-term scheduler."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,567.481,542.85,590.151],"page_index":0,"parent_id":"document","parent_path":[]},"text":"First-Come, First-Served (FCFS) is the simplest scheduling algorithm but suffers\nfrom the convoy effect where a slow process holds up the queue."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,601.531,512.84,624.201],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Shortest Job Next (SJN) minimizes average waiting time but requires complex\nprediction of the next CPU burst length."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,635.581,500.84,658.251],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Round Robin (RR) scheduling assigns a fixed time quantum to each process,\nensuring fairness and preventing starvation."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,669.631,542.85,692.301],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Priority scheduling assigns a rank to each process, which can lead to starvation\nif low-priority background tasks are continuously preempted."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,703.681,500.84,726.351],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Aging is a technique used to resolve starvation by gradually increasing a\nwaiting process's priority over time."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,737.731,518.84,760.401],"page_index":0,"parent_id":"document","parent_path":[]},"text":"Context switching is the computationally expensive process of saving the old\nprocess state and loading the new process state."},{"block_type_hint":"paragraph","page_index":0,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,771.781,518.84,783.101],"page_index":0,"parent_id":"document","parent_path":[]},"text":"OS designers strive to minimize context switches because they represent pure"},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,56.731,368.8,68.051],"page_index":1,"parent_id":"document","parent_path":[]},"text":"overhead where no actual application work gets done."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,79.431,542.85,102.101],"page_index":1,"parent_id":"document","parent_path":[]},"text":"Threads are the smallest sequence of programmed instructions that can be managed\nindependently by a system scheduler."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,113.481,536.84,136.151],"page_index":1,"parent_id":"document","parent_path":[]},"text":"A single process can contain multiple threads that share the same data and heap\nbut maintain individual execution stacks."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,147.531,500.84,170.201],"page_index":1,"parent_id":"document","parent_path":[]},"text":"Multithreading allows a single application to perform multiple operations\nconcurrently, vastly improving performance on multi-core hardware."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,181.581,524.84,204.251],"page_index":1,"parent_id":"document","parent_path":[]},"text":"Concurrency introduces synchronization challenges like race conditions, where\nthe timing of threads affects the final output."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,215.631,506.84,238.301],"page_index":1,"parent_id":"document","parent_path":[]},"text":"Mutexes (mutual exclusion locks) are used to prevent multiple threads from\naccessing a shared resource simultaneously."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,249.681,530.84,272.351],"page_index":1,"parent_id":"document","parent_path":[]},"text":"Semaphores are signaling mechanisms used to control access to common resources\nby multiple processes in a concurrent environment."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,283.731,536.84,306.401],"page_index":1,"parent_id":"document","parent_path":[]},"text":"Deadlocks occur when a set of processes are permanently blocked because each is\nwaiting for a resource held by another."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,317.781,506.84,351.801],"page_index":1,"parent_id":"document","parent_path":[]},"text":"The OS handles deadlocks through prevention, avoidance strategies like the\nBanker's Algorithm, detection, or by simply ignoring them (the Ostrich\nalgorithm)."},{"block_type_hint":"paragraph","page_index":1,"parent_id":"document","parent_path":[],"printed_page":null,"source_metadata":{"extraction_method":"native","sha256":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"},"structured_location":{"bbox":[56.8,363.181,524.84,385.851],"page_index":1,"parent_id":"document","parent_path":[]},"text":"Memory management coordinates all system RAM, tracking each byte and deciding\nwhich processes get memory and when."}],"content_hash":"80c9e5d4611e6be9a54d64643ddb5a1f2ec775f2b6112b15b6b8bf300b8af2e6"}