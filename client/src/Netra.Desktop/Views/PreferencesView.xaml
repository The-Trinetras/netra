<UserControl x:Class="Netra.Desktop.Views.PreferencesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
    </UserControl.Resources>

    <StackPanel Margin="12">
        <TextBlock Text="Preferences and status" FontSize="16" Margin="0,0,0,12" />

        <!-- Sign-in (D-CRED). Live mode only; the outcome of each action is
             announced by the conversation's status region. -->
        <TextBlock x:Name="AccountHeading" Text="Sign-in" FontSize="14" Margin="0,0,0,4"
                   AutomationProperties.HeadingLevel="Level2" />
        <TextBlock x:Name="AccountStatusText" Text="{Binding AccountStatus, Mode=OneWay}" TextWrapping="Wrap"
                   AutomationProperties.Name="Sign-in status" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
                    Visibility="{Binding HasAccount, Converter={StaticResource VisibleWhenTrue}}">
            <Button x:Name="SignInButton"
                    Content="Sign _in with an access code…"
                    Command="{Binding SignInCommand}"
                    AutomationProperties.Name="Sign in with an access code"
                    Margin="0,0,8,0" Padding="8,2" />
            <Button x:Name="SignOutButton"
                    Content="Sign _out of Netra on this computer…"
                    Click="OnSignOutClick"
                    AutomationProperties.Name="Sign out of Netra on this computer"
                    Padding="8,2" />
        </StackPanel>

        <TextBlock AutomationProperties.Name="Connection state" Margin="0,0,0,4">
            <Run Text="Connection: " FontWeight="Bold" />
            <Run Text="{Binding ConnectionState, Mode=OneWay}" />
        </TextBlock>

        <TextBlock AutomationProperties.Name="Interaction mode" Margin="0,0,0,4">
            <Run Text="Mode: " FontWeight="Bold" />
            <Run Text="{Binding InteractionMode, Mode=OneWay}" />
        </TextBlock>

        <TextBlock x:Name="DataSourceNoticeText"
                   Text="{Binding DataSourceNotice, Mode=OneTime}"
                   AutomationProperties.Name="Data source notice"
                   Margin="0,8,0,0" TextWrapping="Wrap" />

        <TextBlock x:Name="ActivationShortcutText"
                   Text="{Binding ActivationShortcut, Mode=OneWay}"
                   AutomationProperties.Name="Activation shortcut"
                   Margin="0,8,0,0" TextWrapping="Wrap" />

        <!-- F1 lands here: one shortcut per item, read in full by NVDA. -->
        <TextBlock x:Name="ShortcutsHeading" Text="Keyboard shortcuts" FontSize="14" Margin="0,16,0,4"
                   AutomationProperties.HeadingLevel="Level2" />
        <ListBox x:Name="ShortcutList"
                 ItemsSource="{Binding Shortcuts, Mode=OneTime}"
                 AutomationProperties.Name="Keyboard shortcuts"
                 AutomationProperties.LabeledBy="{Binding ElementName=ShortcutsHeading}"
                 MaxHeight="220">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Mode=OneWay}" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding Keys, Mode=OneWay}" FontWeight="Bold" />
                        <Run Text=": " />
                        <Run Text="{Binding Action, Mode=OneWay}" />
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Text="Playback measurements (test use)" FontSize="14" Margin="0,16,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Timing of received, queued, played and acknowledged audio on this computer. Contains no text or audio. Saved only when you choose; never uploaded." />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="SaveMeasurementsButton"
                    Content="_Save playback measurements…"
                    AutomationProperties.Name="Save playback measurements"
                    Click="OnSaveMeasurementsClick"
                    Margin="0,0,8,0" Padding="8,2" />
            <Button x:Name="ClearMeasurementsButton"
                    Content="C_lear playback measurements"
                    AutomationProperties.Name="Clear playback measurements"
                    Click="OnClearMeasurementsClick"
                    Padding="8,2" />
        </StackPanel>
        <TextBlock x:Name="MeasurementStatusRegion"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Measurement status"
                   Text="{Binding MeasurementStatus, Mode=OneWay}"
                   Margin="0,4,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
