      "versions": [
        {
          "source_version_id": "6d74dce1-f0b7-5533-95ae-e518c9458946",
          "version_number": 1,
          "status": "ready",
          "is_active": true,
          "deleted": false
        }
      ],
      "locator_scheme": "section/paragraph and numbered problems",
      "media": null,
      "evidence": [
        {
          "evidence_id": "s2-p1",
          "source_version_id": "6d74dce1-f0b7-5533-95ae-e518c9458946",
          "locator": "section 1, paragraph 1",
          "text": "In a parallel circuit each resistor is connected directly across the supply, so every resistor has the full supply voltage across it.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null,
          "defined_in": "evaluation/sources/synthetic_miniatures_v1.json#mini-parallel-circuits"
        },
        {
          "evidence_id": "s2-p2",
          "source_version_id": "6d74dce1-f0b7-5533-95ae-e518c9458946",
          "locator": "section 1, paragraph 2",
          "text": "For two resistors in parallel, the total resistance is found from 1/R_total = 1/R1 + 1/R2. The total resistance of a parallel combination is always smaller than the smallest individual resistance.",
