# ---------------------------------------------------------------------------
# Copy to .env and fill in. ONLY the first line is required to run the kit and
# the notes slice (demo/notes). Everything else is an upgrade you can add later
# without touching code. .env is git-ignored: never commit real keys.
# Keep comments on their own lines: the kit's .env reader does not strip a
# trailing "# comment" from a value.
# ---------------------------------------------------------------------------

# REQUIRED - the capped key handed to you at the registration desk.
OPENROUTER_API_KEY=

# Chosen by running scripts/bakeoff.py TWICE, not by reading a pricing page.
# 8/8 perfect across both runs on parse, schema, correct BLOCK and objection
# specificity. Fastest at ~2.0s, and the cheapest thing that behaved.
# PINNED VERSION: never a ":batch" variant (not callable via /chat/completions)
# and never a "~...latest" alias - a judge re-running your demo must get the
# same behaviour.
SLICE_MODEL=inclusionai/ling-3.0-flash

# Availability insurance, deliberately a different provider family. Also 8/8,
# 2.4s, from an established lab served by several providers - so if the default
# has an outage this is a real safety net and not a second single point of failure.
SLICE_FALLBACK_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Rejected, and why - so nobody helpfully "optimises" these back in:
#   qwen/qwen3.7-flash   cheap, 1M context, and unusable. Unparseable output on
#                        one run, HTTP 429 on the next. Two runs, two failures.
#   z-ai/glm-5.3-flash   NOT actually rejected on merit - see below. It failed
#                        our eval because it is verbose (~890 tokens) and the
#                        eval capped output at 700, cutting it off mid-JSON.
#                        Correct behaviour, wrong parameter. Re-test it before
#                        ruling it out; it may be the better choice.
#   openai/gpt-oss-120b  perfect but ~11.5s per call. In a gate loop that
#                        revises three times, that is a demo which feels hung.

SLICE_ESCALATION_MODEL=anthropic/claude-haiku-4.5

# OPTIONAL - free tier, 1B tokens/month. If set, cheap calls route here first.
# Needs phone verification and a data-training opt-in: do not put anything
# confidential through this key.
MISTRAL_API_KEY=

# OPTIONAL - tracing. If these are blank the tracer no-ops and nothing breaks.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Budgets. These are the fences. Lower them, never raise them casually.
SLICE_MAX_TOKENS_PER_RUN=250000
# Per-request output ceiling, and it pulls in two directions.
#   Too HIGH: OpenRouter reserves against max_tokens, so requests start failing
#             with HTTP 402 while you still have usable credit.
#   Too LOW:  a verbose model is cut off mid-JSON. llm.py raises Truncated and
#             tells you so, rather than letting it look like a prompt problem -
#             we lost time to exactly that mistake.
# 1200 suits a terse default model. Raise it if you see Truncated.
SLICE_MAX_TOKENS=1200
SLICE_MAX_ATTEMPTS_PER_STEP=3
SLICE_EXPERT_TIMEOUT_MINUTES=45

# OPTIONAL - Arize AX tracing for the notes slice (demo/notes/tracing.py).
# If blank, the exporter does nothing. May use the same space as NETRA_AX_*.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=netra-notes

# ---------------------------------------------------------------------------
# Netra API, worker and client (api/, worker/, client/). OPTIONAL: only for the
# full product. The API and worker read NETRA_* from their process environment
# and never read this file on their own; to run the API from it:
#   uvicorn --env-file .env --app-dir api/src --factory netra_api.main:create_app
# Uncomment only what you use. The API treats a blank NETRA_* line as unset.
# Decisions and AWS details: docs/team/integration-status.md.
# Tests never see these values (conftest.py isolates each test from .env).
# ---------------------------------------------------------------------------

# Local integration tests only: the throwaway Docker database, never RDS.
# NETRA_TEST_DATABASE_URL=postgresql+asyncpg://netra_test:netra_test_local_only@127.0.0.1:55432/netra_test

# Application database: AWS RDS behind PgBouncer. Keep an SSM port forward to
# the PgBouncer instance open (command in integration-status.md) and connect to
# 127.0.0.1:6432. Unset -> persistence fails closed.
# NETRA_DATABASE_URL=postgresql+asyncpg://netra_app:<password>@127.0.0.1:6432/netra
# NETRA_DATABASE_POOL_SIZE=5
# Required for any authenticated request (the default rejects all).
# NETRA_AUTH_MODE=stored_credential
# "ax" has no exporter yet; keep off until it exists.
# NETRA_TRACING_MODE=off

# S3 source storage. Prefer a named AWS CLI profile over access keys.
# NETRA_STORAGE_PROVIDER=s3
# Bucket name: `terraform output document_bucket_name`.
# NETRA_S3_BUCKET=
# NETRA_AWS_REGION=ap-south-1
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Local fixture development only:
# NETRA_STORAGE_PROVIDER=local_fixture
# NETRA_LOCAL_FIXTURE_ROOT=evaluation/fixtures

# Embeddings and vector search. The Pinecone index must exist with dimension
# 1536 and metric cosine. With an OpenRouter key set (below), this key serves
# embeddings only.
# NETRA_GEMINI_API_KEY=
# NETRA_EMBEDDING_MODEL=gemini-embedding-001
# NETRA_EMBEDDING_DIMENSION=1536
# NETRA_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# NETRA_GEMINI_EMBEDDING_DIMENSION=1536
# NETRA_PINECONE_API_KEY=
# NETRA_PINECONE_INDEX_NAME=netra
# NETRA_PINECONE_NAMESPACE=netra
# Windows developer OCR install (defaults to "tesseract" on PATH):
# NETRA_TESSERACT_EXECUTABLE=C:\Program Files\Tesseract-OCR\tesseract.exe

# Agent models through OpenRouter (decision D-AGENT). Same approved models.
# When set, this runs both agents even if Gemini or Groq keys are set.
# The Agent-a-thon key works here (the same value as OPENROUTER_API_KEY).
# NETRA_OPENROUTER_API_KEY=
# NETRA_OPENROUTER_COORDINATOR_MODEL=google/gemini-3.8-flash
# NETRA_OPENROUTER_TUTOR_MODEL=openai/gpt-oss-120b
# Optional: the Tutor directly on Groq, used only without an OpenRouter key.
# NETRA_GROQ_API_KEY=

# Learning-history graph (worker).
# NETRA_NEO4J_URI=
# NETRA_NEO4J_USER=
# NETRA_NEO4J_PASSWORD=

# ---- Not read by any code yet: these are wired in later phases. ----

# ElevenLabs speech output. eleven_flash_v2_5 is the low-latency model.
# NETRA_ELEVENLABS_API_KEY=
# NETRA_ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# NETRA_ELEVENLABS_VOICE_ID=
# NETRA_ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Twelve Labs video evidence (Marengo search, Pegasus description). Model names
# must match the ones your index was created with; the decision is Marengo 3.0
# and Pegasus 1.5 (marengo3.0, pegasus1.5).
# NETRA_TWELVE_LABS_API_KEY=
# NETRA_TWELVE_LABS_INDEX_ID=
# NETRA_TWELVE_LABS_MARENGO_MODEL_NAME=
# NETRA_TWELVE_LABS_MARENGO_MODEL_VERSION=
# NETRA_TWELVE_LABS_PEGASUS_MODEL_NAME=
# NETRA_TWELVE_LABS_PEGASUS_MODEL_VERSION=
# NETRA_TWELVE_LABS_SEARCH_OPTIONS=visual,audio
# NETRA_TWELVE_LABS_SEARCH_PAGE_LIMIT=10
# One Pegasus call per 30 s window; 120 windows cover a 1-hour video.
# NETRA_TWELVE_LABS_DESCRIPTION_WINDOW_MS=30000
# NETRA_TWELVE_LABS_MAX_DESCRIPTION_WINDOWS=120
# NETRA_TWELVE_LABS_PEGASUS_MAX_TOKENS=512
# NETRA_TWELVE_LABS_RECONCILE_MAX_PAGES=3
# NETRA_TWELVE_LABS_RECONCILE_PAGE_LIMIT=50
# NETRA_TWELVE_LABS_RECONCILE_TIMEOUT_SECONDS=10

# YouTube analysis through Tunelio (decision M3-YT-ANALYSIS); unset -> off.
# NETRA_TUNELIO_API_KEY=

# Tavily YouTube lecture discovery (YouTube domains only).
# NETRA_TAVILY_API_KEY=
# basic or advanced ("advanced" costs more credits per search).
# NETRA_TAVILY_SEARCH_DEPTH=basic
# NETRA_TAVILY_TIMEOUT_SECONDS=10
# Raw results requested (max 20); non-video results are dropped.
# NETRA_TAVILY_REQUEST_MAX_RESULTS=10

# Deepgram voice input.
# NETRA_DEEPGRAM_API_KEY=

# Arize AX tracing for the API (set NETRA_TRACING_MODE=ax once the exporter exists).
# NETRA_AX_SPACE_ID=
# NETRA_AX_API_KEY=
# NETRA_AX_PROJECT_NAME=netra

# Modal: Prometheus-2 evaluation judge (offline evaluation only). The URL is
# printed by `modal deploy evaluation/deploy/prometheus_modal.py` and has the
# form https://<workspace>--netra-prometheus-judge-prometheusjudge-web.modal.run
# NETRA_EVAL_JUDGE_URL=
# NETRA_EVAL_MODAL_PROXY_TOKEN_ID=
# NETRA_EVAL_MODAL_PROXY_TOKEN_SECRET=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# WPF client live mode. The client reads this from its own process environment,
# not from this file: set it in the shell that starts Netra.Desktop.
# NETRA_API_ENDPOINT=ws://127.0.0.1:8000/v1/ws
