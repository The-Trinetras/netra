# Example process environment for local development. Copy values into your
# shell or process manager; the application does not read a .env file.
# Never commit real credentials.

# Application database (M1 Settings). Unset -> persistence fails closed.
NETRA_DATABASE_URL=postgresql+asyncpg://netra_test:netra_test_local_only@127.0.0.1:55432/netra_test
NETRA_TRACING_MODE=off

# M2 content/worker settings (netra_api.content.settings.ContentSettings)
NETRA_DATABASE_POOL_SIZE=5
NETRA_STORAGE_PROVIDER=s3
NETRA_S3_BUCKET=
NETRA_AWS_REGION=
# Local fixture development only:
# NETRA_STORAGE_PROVIDER=local_fixture
# NETRA_LOCAL_FIXTURE_ROOT=evaluation/fixtures
NETRA_EMBEDDING_MODEL=gemini-embedding-001
NETRA_EMBEDDING_DIMENSION=1536
NETRA_GEMINI_API_KEY=
NETRA_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
NETRA_GEMINI_EMBEDDING_DIMENSION=1536
NETRA_PINECONE_API_KEY=
NETRA_PINECONE_INDEX_NAME=netra
NETRA_PINECONE_NAMESPACE=netra
# Windows developer OCR install (defaults to "tesseract" on PATH):
# NETRA_TESSERACT_EXECUTABLE=C:\Program Files\Tesseract-OCR\tesseract.exe
