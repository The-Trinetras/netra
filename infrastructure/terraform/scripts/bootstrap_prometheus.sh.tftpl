#!/bin/bash
set -euo pipefail

MODEL_ID='${model_id}'
MODEL_REVISION='${model_revision}'
VLLM_IMAGE='${vllm_image}'

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io curl
systemctl enable --now docker
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || snap start amazon-ssm-agent

install -d -m 0755 /var/lib/netra-prometheus/huggingface /var/lib/netra-prometheus/vllm

cat >/etc/systemd/system/netra-prometheus.service <<EOF
[Unit]
Description=Netra evaluation-only Prometheus-2 server
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/docker pull $VLLM_IMAGE
ExecStartPre=-/usr/bin/docker rm netra-prometheus
ExecStart=/usr/bin/docker run --name netra-prometheus --rm --gpus all --network host --ipc host --shm-size 8g -v /var/lib/netra-prometheus/huggingface:/root/.cache/huggingface -v /var/lib/netra-prometheus/vllm:/root/.cache/vllm $VLLM_IMAGE --host 127.0.0.1 --port 8000 --model $MODEL_ID --revision $MODEL_REVISION --served-model-name $MODEL_ID --dtype auto --max-model-len 4096 --gpu-memory-utilization 0.90
ExecStop=/usr/bin/docker stop netra-prometheus

[Install]
WantedBy=multi-user.target
EOF

cat >/usr/local/bin/netra-prometheus-health <<'EOF'
#!/bin/sh
exec curl --fail --silent --show-error --max-time 5 http://127.0.0.1:8000/health
EOF
chmod 0755 /usr/local/bin/netra-prometheus-health

systemctl daemon-reload
systemctl enable --now netra-prometheus.service
