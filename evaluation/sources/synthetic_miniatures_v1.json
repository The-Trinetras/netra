  "sources": [
    {
      "source_key": "mini-series-circuits",
      "title": "Series circuits (synthetic miniature study note)",
      "kind": "document",
      "origin": "new_synthetic_miniature",
      "permission": "synthetic",
      "source_id": "33a2fea4-1601-5061-b9ab-56cace3ee9e2",
      "owner_account_id": "15f4f166-861d-55e2-a845-0b02ccaa4b74",
      "versions": [
        {
          "source_version_id": "72201904-4576-57ef-bc75-8b516ece51c1",
          "version_number": 1,
          "status": "ready",
          "is_active": true,
          "deleted": false
        }
      ],
      "locator_scheme": "section/paragraph and numbered problems",
      "media": null,
      "evidence": [
        {
          "evidence_id": "s1-p1",
          "source_version_id": "72201904-4576-57ef-bc75-8b516ece51c1",
          "locator": "section 1, paragraph 1",
          "text": "In a series circuit the components are connected one after another, so there is only one path for the current. The same current flows through every component in the circuit.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        },
        {
          "evidence_id": "s1-p2",
          "source_version_id": "72201904-4576-57ef-bc75-8b516ece51c1",
          "locator": "section 1, paragraph 2",
          "text": "The total resistance of resistors connected in series is the sum of their individual resistances: R_total = R1 + R2.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        },
        {
          "evidence_id": "s1-p3",
          "source_version_id": "72201904-4576-57ef-bc75-8b516ece51c1",
          "locator": "section 1, paragraph 3",
          "text": "The current drawn from the supply is the supply voltage divided by the total resistance: I = V / R_total. The voltage across each resistor is the current multiplied by that resistor's resistance.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        },
        {
          "evidence_id": "s1-prob1",
          "source_version_id": "72201904-4576-57ef-bc75-8b516ece51c1",
          "locator": "problem 1",
          "text": "Problem 1: A 2 ohm resistor (R1) and a 3 ohm resistor (R2) are connected in series to a 10 V supply.",
          "trust": "source_verified",
          "kind": "problem",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        }
      ],
      "notes": [
        "Self-authored for evaluation on 2026-09-19; not a real textbook.",
        "Problem 1 deliberately gives no solution, so a calculation must be derived from the rules."
      ]
    },
    {
      "source_key": "mini-parallel-circuits",
      "title": "Parallel circuits (synthetic miniature study note)",
      "kind": "document",
      "origin": "new_synthetic_miniature",
      "permission": "synthetic",
      "source_id": "d90b7e29-ea35-5312-a280-66f653b41dbe",
      "owner_account_id": "15f4f166-861d-55e2-a845-0b02ccaa4b74",
      "versions": [
        {
          "source_version_id": "6d74dce1-f0b7-5533-95ae-e518c9458946",
          "version_number": 1,
          "status": "ready",
          "is_active": true,
          "deleted": false
        }
      ],
      "locator_scheme": "section/paragraph and numbered problems",
      "media": null,
      "evidence": [
        {
          "evidence_id": "s2-p1",
          "source_version_id": "6d74dce1-f0b7-5533-95ae-e518c9458946",
          "locator": "section 1, paragraph 1",
          "text": "In a parallel circuit each resistor is connected directly across the supply, so every resistor has the full supply voltage across it.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        },
        {
          "evidence_id": "s2-p2",
          "source_version_id": "6d74dce1-f0b7-5533-95ae-e518c9458946",
          "locator": "section 1, paragraph 2",
          "text": "For two resistors in parallel, the total resistance is found from 1/R_total = 1/R1 + 1/R2. The total resistance of a parallel combination is always smaller than the smallest individual resistance.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        },
        {
          "evidence_id": "s2-p3",
          "source_version_id": "6d74dce1-f0b7-5533-95ae-e518c9458946",
          "locator": "section 1, paragraph 3",
          "text": "The current in each branch is the supply voltage divided by that branch's resistance, and the current drawn from the supply is the sum of the branch currents.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        },
        {
          "evidence_id": "s2-prob1",
          "source_version_id": "6d74dce1-f0b7-5533-95ae-e518c9458946",
          "locator": "problem 1",
          "text": "Problem 1: Two 6 ohm resistors are connected in parallel across a 12 V supply.",
          "trust": "source_verified",
          "kind": "problem",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        }
      ],
      "notes": [
        "Self-authored for evaluation on 2026-09-19; not a real textbook."
      ]
    },
    {
      "source_key": "mini-electrical-power",
      "title": "Electrical power (synthetic miniature study note)",
      "kind": "document",
      "origin": "new_synthetic_miniature",
      "permission": "synthetic",
      "source_id": "409f4527-6bd9-51a8-b950-c06a5e34f65f",
      "owner_account_id": "15f4f166-861d-55e2-a845-0b02ccaa4b74",
      "versions": [
        {
          "source_version_id": "97739d51-9e82-5c42-a252-8a8f6192ed5a",
          "version_number": 1,
          "status": "ready",
          "is_active": true,
          "deleted": false
        }
      ],
      "locator_scheme": "section/paragraph and numbered tables",
      "media": null,
      "evidence": [
        {
          "evidence_id": "s3-p1",
          "source_version_id": "97739d51-9e82-5c42-a252-8a8f6192ed5a",
          "locator": "section 1, paragraph 1",
          "text": "Electrical power is the rate at which energy is transferred. It is measured in watts (W); one watt is one joule of energy transferred each second.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        },
        {
          "evidence_id": "s3-p2",
          "source_version_id": "97739d51-9e82-5c42-a252-8a8f6192ed5a",
          "locator": "section 1, paragraph 2",
          "text": "The power delivered to a component equals the voltage across it multiplied by the current through it: P = V × I.",
          "trust": "source_verified",
          "kind": "passage",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        },
        {
          "evidence_id": "s3-tab1",
          "source_version_id": "97739d51-9e82-5c42-a252-8a8f6192ed5a",
          "locator": "table 1",
          "text": "Table 1, two lamps: lamp A, 6 V across it, 3 A through it; lamp B, 12 V across it, 0.5 A through it.",
          "trust": "source_verified",
          "kind": "table",
          "variant": null,
          "start_ms": null,
          "end_ms": null
        }
      ],
      "notes": [
        "Self-authored for evaluation on 2026-09-19; not a real textbook.",
        "No operating time is given anywhere, so total energy cannot be computed from this source."
      ]
    },
