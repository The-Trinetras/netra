# Files executed or parsed on Linux hosts must keep LF endings, even when the
# repository is checked out on Windows with core.autocrlf=true. A boot script
# with CRLF endings fails in bash at "set -euo pipefail".
*.sh          text eol=lf
*.tftpl       text eol=lf
*.tf          text eol=lf
*.hcl         text eol=lf
*Dockerfile   text eol=lf
*.conf        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
