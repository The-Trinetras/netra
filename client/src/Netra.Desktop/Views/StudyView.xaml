<UserControl x:Class="Netra.Desktop.Views.StudyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:study="clr-namespace:Netra.Desktop.Study">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Detected passages, figures, tables and equations"
                   FontSize="16" Margin="0,0,0,8" />

        <ListBox x:Name="DetectedObjectsList" Grid.Row="1"
                 ItemsSource="{Binding DetectedObjects}"
                 AutomationProperties.Name="Detected objects in current reading position"
                 TabIndex="0">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type study:DetectedObject}">
                    <TextBlock Text="{Binding Label, Mode=OneWay}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.InputBindings>
                <KeyBinding Key="Return" Command="{Binding ExploreCommand}"
                            CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            </ListBox.InputBindings>
        </ListBox>

        <TextBlock x:Name="StudyStatusRegion" Grid.Row="2" Margin="0,8,0,8"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="Study status" />

        <Button Grid.Row="3" Content="Back to reading"
                Command="{Binding ReturnToReadingCommand}"
                AutomationProperties.Name="Back to reading"
                TabIndex="1" HorizontalAlignment="Left" Padding="8,4" />
    </Grid>
</UserControl>
